UNWIND [{aliases: ['hay đói', 'đói nhiều'], aliases_text: 'An nhieu | doi nhieu | hay doi | hay đói | Ăn nhiều | đói nhiều', group: 'trieu_chung_kinh_dien', id: 'an_nhieu', name_en: 'Polyphagia', name_vi: 'Ăn nhiều', question_vi: 'Gần đây anh/chị có hay đói, ăn nhiều hơn bình thường không?'}, {aliases: ['nôn', 'buồn nôn'], aliases_text: 'Buon non | Buồn nôn | buon non | buồn nôn | non | nôn', group: 'canh_bao', id: 'buon_non', name_en: 'Nausea', name_vi: 'Buồn nôn'}, {aliases: ['đau chân khi đi lại'], aliases_text: 'Dau cach hoi chi duoi | dau chan khi di lai | Đau cách hồi chi dưới | đau chân khi đi lại', group: 'bien_chung', id: 'dau_cach_hoi', name_en: 'Intermittent claudication', name_vi: 'Đau cách hồi chi dưới', question_vi: 'Anh/chị có bị đau chân khi đi lại, nghỉ thì đỡ không?'}, {aliases: ['tức ngực'], aliases_text: 'Dau nguc | tuc nguc | tức ngực | Đau ngực', group: 'bien_chung', id: 'dau_nguc', name_en: 'Chest pain', name_vi: 'Đau ngực', question_vi: 'Anh/chị có hay bị đau tức ngực không?'}, {aliases: ['đầy bụng', 'chậm tiêu', 'nuốt khó'], aliases_text: 'Day bung, cham tieu, nuot kho | cham tieu | chậm tiêu | day bung | nuot kho | nuốt khó | Đầy bụng, chậm tiêu, nuốt khó | đầy bụng', group: 'bien_chung', id: 'day_bung_cham_tieu', name_en: 'Bloating / gastroparesis', name_vi: 'Đầy bụng, chậm tiêu, nuốt khó', question_vi: 'Anh/chị có hay đầy bụng, chậm tiêu hoặc nuốt khó không?'}, {aliases: ['hơi thở mùi trái cây', 'hơi thở có mùi'], aliases_text: 'Hoi tho mui tao thoi | Hơi thở mùi táo thối | hoi tho co mui | hoi tho mui trai cay | hơi thở có mùi | hơi thở mùi trái cây', group: 'canh_bao', id: 'hoi_tho_mui_tao_thoi', name_en: 'Fruity breath odor', name_vi: 'Hơi thở mùi táo thối'}, {aliases: ['vết thương lâu lành', 'loét chân'], aliases_text: 'Loet, nhiem trung ban chan | Loét, nhiễm trùng bàn chân | loet chan | loét chân | vet thuong lau lanh | vết thương lâu lành', group: 'bien_chung', id: 'loet_ban_chan', name_en: 'Foot ulcer / infection', name_vi: 'Loét, nhiễm trùng bàn chân', question_vi: 'Anh/chị có vết loét hoặc vết thương lâu lành ở bàn chân không?'}, {aliases: ['mờ mắt', 'thị lực giảm'], aliases_text: 'Nhin mo | Nhìn mờ | mo mat | mờ mắt | thi luc giam | thị lực giảm', group: 'bien_chung', id: 'nhin_mo', name_en: 'Blurred vision', name_vi: 'Nhìn mờ', question_vi: 'Anh/chị có thấy mắt nhìn mờ đi không?'}, {aliases: ['lơ mơ', 'ngủ gà', 'hôn mê', 'ngất'], aliases_text: 'Roi loan y thuc (lo mo, ngu ga, hon me) | Rối loạn ý thức (lơ mơ, ngủ gà, hôn mê) | hon me | hôn mê | lo mo | lơ mơ | ngat | ngu ga | ngất | ngủ gà', group: 'canh_bao', id: 'roi_loan_y_thuc', name_en: 'Altered consciousness', name_vi: 'Rối loạn ý thức (lơ mơ, ngủ gà, hôn mê)'}, {aliases: ['gầy sút cân', 'gầy nhiều', 'giảm cân không rõ lý do'], aliases_text: 'Sut can khong ro ly do | Sụt cân không rõ lý do | gay nhieu | gay sut can | giam can khong ro ly do | giảm cân không rõ lý do | gầy nhiều | gầy sút cân', group: 'trieu_chung_kinh_dien', id: 'sut_can', name_en: 'Unexplained weight loss', name_vi: 'Sụt cân không rõ lý do', question_vi: 'Anh/chị có bị sụt cân mà không rõ lý do trong thời gian gần đây không?'}, {aliases: ['tê bì chân', 'tê chân', 'dị cảm'], aliases_text: 'Te bi di cam o ban chan | Tê bì dị cảm ở bàn chân | di cam | dị cảm | te bi chan | te chan | tê bì chân | tê chân', group: 'bien_chung', id: 'te_bi_ban_chan', name_en: 'Foot numbness / paresthesia', name_vi: 'Tê bì dị cảm ở bàn chân', question_vi: 'Anh/chị có bị tê bì, kiến bò hay châm chích ở bàn chân không?'}, {aliases: ['thở dốc', 'khó thở', 'thở nhanh sâu'], aliases_text: 'Tho nhanh | Thở nhanh | kho tho | khó thở | tho doc | tho nhanh sau | thở dốc | thở nhanh sâu', group: 'canh_bao', id: 'tho_nhanh', name_en: 'Tachypnea', name_vi: 'Thở nhanh'}, {aliases: ['đi tiểu nhiều', 'tiểu đêm', 'đái nhiều'], aliases_text: 'Tieu nhieu | Tiểu nhiều | dai nhieu | di tieu nhieu | tieu dem | tiểu đêm | đi tiểu nhiều | đái nhiều', group: 'trieu_chung_kinh_dien', id: 'tieu_nhieu', name_en: 'Polyuria', name_vi: 'Tiểu nhiều', question_vi: 'Anh/chị có đi tiểu nhiều lần, kể cả ban đêm, hơn trước không?'}, {aliases: ['khát nước', 'khát nhiều', 'uống nhiều nước'], aliases_text: 'Uong nhieu (hay khat nuoc) | Uống nhiều (hay khát nước) | khat nhieu | khat nuoc | khát nhiều | khát nước | uong nhieu nuoc | uống nhiều nước', group: 'trieu_chung_kinh_dien', id: 'uong_nhieu', name_en: 'Polydipsia', name_vi: 'Uống nhiều (hay khát nước)', question_vi: 'Anh/chị có hay khát nước, uống nhiều nước hơn bình thường không?'}] AS row
MERGE (n:Symptom {id: row.id}) SET n += row;
// ---- RiskFactor ----
UNWIND [{aliases: ['bệnh tự miễn'], aliases_text: 'Mac benh tu mien khac | Mắc bệnh tự miễn khác | benh tu mien | bệnh tự miễn', group: 'tien_su_nguy_co', id: 'benh_tu_mien', name_vi: 'Mắc bệnh tự miễn khác', question_vi: 'Anh/chị có mắc bệnh tự miễn nào không?'}, {aliases: ['béo phì', 'thừa cân', 'béo'], aliases_text: 'Thua can / beo phi (BMI ≥ 23) | Thừa cân / béo phì (BMI ≥ 23) | beo | beo phi | béo | béo phì | thua can | thừa cân', group: 'tien_su_nguy_co', id: 'bmi_tu_23', name_vi: 'Thừa cân / béo phì (BMI ≥ 23)', question_vi: 'Anh/chị cao và nặng bao nhiêu (để tính chỉ số BMI)?'}, {aliases: ['buồng trứng đa nang'], aliases_text: 'Hoi chung buong trung da nang | Hội chứng buồng trứng đa nang | buong trung da nang | buồng trứng đa nang', group: 'tien_su_nguy_co', id: 'buong_trung_da_nang', name_vi: 'Hội chứng buồng trứng đa nang', question_vi: 'Chị có được chẩn đoán hội chứng buồng trứng đa nang không?'}, {aliases: ['có thai', 'mang bầu', 'bà bầu', 'mẹ bầu'], aliases_text: 'Dang mang thai | ba bau | bà bầu | co thai | có thai | mang bau | mang bầu | me bau | mẹ bầu | Đang mang thai', group: 'tien_su_nguy_co', id: 'dang_mang_thai', name_vi: 'Đang mang thai', question_vi: 'Chị có đang mang thai không? Nếu có thì được bao nhiêu tuần?'}, {aliases: ['ít vận động', 'ít tập thể dục'], aliases_text: 'Loi song tinh tai / it van dong | Lối sống tĩnh tại / ít vận động | it tap the duc | it van dong | ít tập thể dục | ít vận động', group: 'tien_su_nguy_co', id: 'it_van_dong', name_vi: 'Lối sống tĩnh tại / ít vận động', question_vi: 'Anh/chị có ít vận động, ít tập thể dục (ngồi nhiều) không?'}, {aliases: ['mỡ máu cao', 'rối loạn lipid máu'], aliases_text: 'Roi loan mo mau | Rối loạn mỡ máu | mo mau cao | mỡ máu cao | roi loan lipid mau | rối loạn lipid máu', group: 'tien_su_nguy_co', id: 'roi_loan_lipid', name_vi: 'Rối loạn mỡ máu', question_vi: 'Anh/chị có bị mỡ máu cao (rối loạn lipid máu) không?'}, {aliases: ['huyết áp cao', 'cao huyết áp'], aliases_text: 'Tang huyet ap | Tăng huyết áp | cao huyet ap | cao huyết áp | huyet ap cao | huyết áp cao', group: 'tien_su_nguy_co', id: 'tang_huyet_ap', name_vi: 'Tăng huyết áp', question_vi: 'Anh/chị có bị tăng huyết áp (huyết áp cao) không?'}, {aliases_text: 'Tien su dai thao duong thai ky | Tiền sử đái tháo đường thai kỳ', group: 'tien_su_nguy_co', id: 'tien_su_dtd_thai_ky', name_vi: 'Tiền sử đái tháo đường thai kỳ', question_vi: 'Chị đã từng bị tiểu đường thai kỳ ở lần mang thai trước chưa?'}, {aliases: ['bố bị tiểu đường', 'mẹ bị tiểu đường', 'gia đình có người bị tiểu đường'], aliases_text: 'Gia dinh co nguoi mac dai thao duong | Gia đình có người mắc đái tháo đường | bo bi tieu duong | bố bị tiểu đường | gia dinh co nguoi bi tieu duong | gia đình có người bị tiểu đường | me bi tieu duong | mẹ bị tiểu đường', group: 'tien_su_nguy_co', id: 'tien_su_gia_dinh_dtd', name_vi: 'Gia đình có người mắc đái tháo đường', question_vi: 'Bố, mẹ hoặc anh chị em ruột của anh/chị có ai bị tiểu đường không?'}, {aliases_text: 'Khoi phat duoi 30 tuoi | Khởi phát dưới 30 tuổi', group: 'tien_su_nguy_co', id: 'tuoi_duoi_30', name_vi: 'Khởi phát dưới 30 tuổi', question_vi: 'Anh/chị năm nay bao nhiêu tuổi?'}, {aliases_text: 'Tuoi tu 45 tro len | Tuổi từ 45 trở lên', group: 'tien_su_nguy_co', id: 'tuoi_tu_45', name_vi: 'Tuổi từ 45 trở lên', question_vi: 'Anh/chị năm nay bao nhiêu tuổi?'}] AS row
MERGE (n:RiskFactor {id: row.id}) SET n += row;
// ---- LabTest ----
UNWIND [{aliases: ['đường huyết bất kỳ', 'đường máu bất kỳ'], aliases_text: 'Glucose huyet tuong bat ky | Glucose huyết tương bất kỳ | duong huyet bat ky | duong mau bat ky | đường huyết bất kỳ | đường máu bất kỳ', id: 'GLUCOSE_BAT_KY', kind: 'numeric', name_en: 'Random plasma glucose', name_vi: 'Glucose huyết tương bất kỳ', question_vi: 'Anh/chị có đo đường huyết bất kỳ lúc nào gần đây không, kết quả bao nhiêu?', unit: 'mmol/L'}, {aliases: ['đường huyết lúc đói', 'đường máu lúc đói', 'glucose lúc đói'], aliases_text: 'Glucose huyet tuong luc doi | Glucose huyết tương lúc đói | duong huyet luc doi | duong mau luc doi | glucose luc doi | glucose lúc đói | đường huyết lúc đói | đường máu lúc đói', id: 'GLUCOSE_DOI', kind: 'numeric', name_en: 'Fasting plasma glucose', name_vi: 'Glucose huyết tương lúc đói', question_vi: 'Anh/chị có biết chỉ số đường huyết lúc đói (sáng chưa ăn) gần nhất không? Đơn vị mmol/L hoặc mg/dL, nếu không biết cứ nói không biết.', unit: 'mmol/L'}, {aliases: ['hba1c', 'đường huyết trung bình 3 tháng'], aliases_text: 'HbA1c | duong huyet trung binh 3 thang | hba1c | đường huyết trung bình 3 tháng', id: 'HBA1C', kind: 'numeric', name_en: 'Glycated hemoglobin', name_vi: 'HbA1c', question_vi: 'Anh/chị có biết chỉ số HbA1c gần nhất không (đơn vị %)?', unit: '%'}, {aliases_text: 'Glucose 1 gio sau nghiem phap 75 g | Glucose 1 giờ sau nghiệm pháp 75 g', id: 'OGTT_1H', kind: 'numeric', name_en: '1-hour OGTT glucose', name_vi: 'Glucose 1 giờ sau nghiệm pháp 75 g', question_vi: 'Chỉ số đường huyết sau 1 giờ uống nước đường của chị là bao nhiêu?', unit: 'mmol/L'}, {aliases: ['nghiệm pháp dung nạp glucose', 'nghiệm pháp tăng đường huyết', 'uống nước đường'], aliases_text: 'Glucose 2 gio sau nghiem phap 75 g | Glucose 2 giờ sau nghiệm pháp 75 g | nghiem phap dung nap glucose | nghiem phap tang duong huyet | nghiệm pháp dung nạp glucose | nghiệm pháp tăng đường huyết | uong nuoc duong | uống nước đường', id: 'OGTT_2H', kind: 'numeric', name_en: '2-hour OGTT glucose', name_vi: 'Glucose 2 giờ sau nghiệm pháp 75 g', question_vi: 'Anh/chị đã làm nghiệm pháp uống đường (OGTT) chưa? Chỉ số sau 2 giờ là bao nhiêu?', unit: 'mmol/L'}] AS row
MERGE (n:LabTest {id: row.id}) SET n += row;
// ---- Drug ----
UNWIND [{aliases: ['dapagliflozin'], aliases_text: 'Dapagliflozin | dapagliflozin', atc: 'A10BK01', class_vi: 'Ức chế SGLT2', id: 'DAPAGLIFLOZIN', name: 'Dapagliflozin'}, {aliases: ['empagliflozin'], aliases_text: 'Empagliflozin | empagliflozin', atc: 'A10BK03', class_vi: 'Ức chế SGLT2', id: 'EMPAGLIFLOZIN', name: 'Empagliflozin'}, {aliases: ['gliclazide', 'gliclazid'], aliases_text: 'Gliclazid | gliclazid | gliclazide', atc: 'A10BB09', class_vi: 'Sulfonylurê', id: 'GLICLAZID', name: 'Gliclazid'}, {aliases: ['insulin ngoại sinh', 'tiêm insulin'], aliases_text: 'Insulin | insulin ngoai sinh | insulin ngoại sinh | tiem insulin | tiêm insulin', atc: 'A10A', class_vi: 'Insulin', id: 'INSULIN', name: 'Insulin'}, {aliases: ['metformin'], aliases_text: 'Metformin | metformin', atc: 'A10BA02', class_vi: 'Biguanid', id: 'METFORMIN', name: 'Metformin'}, {aliases: ['sitaglyptin', 'sitagliptin'], aliases_text: 'Sitagliptin | sitagliptin | sitaglyptin', atc: 'A10BH01', class_vi: 'Ức chế DPP-4', id: 'SITAGLIPTIN', name: 'Sitagliptin'}] AS row
MERGE (n:Drug {id: row.id}) SET n += row;
// ---- DiagnosticCriterion + DIAGNOSED_BY + USES_TEST ----
UNWIND [{condition: 'co_trieu_chung_kinh_dien', disease_id: 'DTD', evidence: 'mức glucose huyết tương ở thời điểm bất kỳ ≥ 11,1 mmol/l (200 mg/dl)', id: 'CRIT_DTD_GLUCOSE_BAT_KY', note: 'Chỉ áp dụng khi có triệu chứng lâm sàng', op: '>=', source_id: 'MOH-3280-2011', test_id: 'GLUCOSE_BAT_KY', unit: 'mmol/L', value: 11.1}, {disease_id: 'DTD', evidence: 'Mức glucose huyết tương lúc đói ≥ 7,0 mmol/l (≥ 126 mg/dl)', id: 'CRIT_DTD_GLUCOSE_DOI', note: 'Làm 2 lần vào hai ngày khác nhau', op: '>=', source_id: 'MOH-3280-2011', test_id: 'GLUCOSE_DOI', unit: 'mmol/L', value: 7.0}, {disease_id: 'DTD', evidence: 'HbA1C (định lượng bằng phương pháp sắc kí lỏng) >6,5%', id: 'CRIT_DTD_HBA1C', note: 'Nguồn ghi \'>\'; ADA dùng \'≥\'. QĐ 3280/2011 không có tiêu chí HbA1c', op: '>', source_id: 'VMC-0002', test_id: 'HBA1C', unit: '%', value: 6.5}, {disease_id: 'DTD', evidence: 'Mức glucose huyết tương ≥ 11,1 mmol/l (200 mg/dl) ở thời điểm 2 giờ sau nghiệm pháp dung nạp glucose', id: 'CRIT_DTD_OGTT_2H', op: '>=', source_id: 'MOH-3280-2011', test_id: 'OGTT_2H', unit: 'mmol/L', value: 11.1}, {condition: 'dang_mang_thai', disease_id: 'DTD_THAI_KY', evidence: 'Đường máu sau 1 giờ uống nước đường ≥180 mg/dL (10 mmol/l)', id: 'CRIT_DTD_THAI_KY_1H', op: '>=', source_id: 'VMC-0003', test_id: 'OGTT_1H', unit: 'mmol/L', value: 10.0}, {condition: 'dang_mang_thai', disease_id: 'DTD_THAI_KY', evidence: 'Đường máu sau 2 giờ uống nước đường ≥153 mg/dL (8,5 mmol/l)', id: 'CRIT_DTD_THAI_KY_2H', op: '>=', source_id: 'VMC-0003', test_id: 'OGTT_2H', unit: 'mmol/L', value: 8.5}, {condition: 'dang_mang_thai', disease_id: 'DTD_THAI_KY', evidence: 'Đường máu lúc đói ≥ 92 mg/dL (5,1mmol/l)', id: 'CRIT_DTD_THAI_KY_DOI', note: 'OGTT 75 g tuần 24-28; một giá trị đạt là đủ', op: '>=', source_id: 'VMC-0003', test_id: 'GLUCOSE_DOI', unit: 'mmol/L', value: 5.1}, {disease_id: 'TIEN_DTD', evidence: '6,1 mmol/l (110 mg/dl) đến 6,9 mmol/l (125 mg/dl)', id: 'CRIT_TIEN_DTD_GLUCOSE_DOI', note: 'Suy giảm glucose lúc đói (IFG) theo WHO-1999', op: 'between', source_id: 'MOH-3280-2011', test_id: 'GLUCOSE_DOI', unit: 'mmol/L', value: 6.1, value_max: 6.9}, {disease_id: 'TIEN_DTD', evidence: 'từ 7,8 mmol/l (140 mg/dl) đến 11,0 mmol/l (200 mg/dl)', id: 'CRIT_TIEN_DTD_OGTT_2H', note: 'Rối loạn dung nạp glucose (IGT)', op: 'between', source_id: 'MOH-3280-2011', test_id: 'OGTT_2H', unit: 'mmol/L', value: 7.8, value_max: 11.0}] AS row
MERGE (c:DiagnosticCriterion {id: row.id})
SET c.test_id = row.test_id, c.op = row.op, c.value = row.value, c.value_max = row.value_max,
    c.unit = row.unit, c.condition = row.condition, c.note = row.note
WITH c, row
MATCH (d:Disease {id: row.disease_id}), (t:LabTest {id: row.test_id})
MERGE (d)-[r:DIAGNOSED_BY]->(c) SET r.source_id = row.source_id, r.evidence = row.evidence
MERGE (c)-[:USES_TEST]->(t);
// ---- DIFFERENTIAL_OF ----
UNWIND [{from: 'DTD_TIP_1', props: {confidence: 0.9, evidence: 'Phân biệt chi tiết tiểu đường type 1 và type 2', source_id: 'VMC-0001'}, to: 'DTD_TIP_2'}] AS row
MATCH (a:Disease {id: row.from}), (b:Disease {id: row.to})
MERGE (a)-[r:DIFFERENTIAL_OF]->(b) SET r += row.props;
// ---- HAS_COMPLICATION ----
UNWIND [{from: 'DTD', props: {confidence: 0.9, evidence: 'do biến chứng mạch vành', source_id: 'VMC-0002'}, to: 'BENH_MACH_VANH'}, {from: 'DTD', props: {confidence: 0.9, evidence: 'biến chứng thần kinh', source_id: 'VMC-0002'}, to: 'BENH_THAN_KINH_DTD'}, {from: 'DTD', props: {confidence: 0.9, evidence: 'do biến chứng võng mạc', source_id: 'VMC-0002'}, to: 'BENH_VONG_MAC_DTD'}, {from: 'DTD', props: {confidence: 0.7, evidence: 'tránh bị tụt đường huyết', source_id: 'VMC-0002'}, to: 'HA_DUONG_HUYET'}, {from: 'DTD_THAI_KY', props: {confidence: 0.9, evidence: 'Tiền sản giật, sản giật', source_id: 'VMC-0003'}, to: 'TIEN_SAN_GIAT'}, {from: 'DTD_TIP_1', props: {confidence: 0.9, evidence: 'Hôn mê nhiễm toan ceton', source_id: 'VMC-0001'}, to: 'HON_ME_NHIEM_TOAN_CETON'}, {from: 'DTD_TIP_2', props: {confidence: 0.9, evidence: 'Hôn mê tăng áp lực thẩm thấu', source_id: 'VMC-0002'}, to: 'HON_ME_TANG_AP_LUC_THAM_THAU'}] AS row
MATCH (a:Disease {id: row.from}), (b:Disease {id: row.to})
